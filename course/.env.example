# Broken Chatbot ハンズオン用 .env
#
# このファイルを `course/.env` という名前でコピーし、値を設定してください:
#     cp course/.env.example course/.env
#
# ここに書いた値は notebook 実行時に自動で読み込まれます（python-dotenv）。
# 既に設定済みの環境変数 / Colab シークレットがある場合はそちらが優先されます。
# `course/.env` は .gitignore 済みのためコミットされません。

# ── LLM プロバイダ選択（openai / ollama）─────────────────────────────
LLM_PROVIDER=openai

# ── OpenAI（推奨）────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL_NAME=gpt-4o-mini
# OpenAI 互換エンドポイント（Azure / LM Studio / プロキシ等）を使う場合のみ
# OPENAI_BASE_URL=https://your-endpoint/v1

# ── Ollama（LLM_PROVIDER=ollama のとき）──────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_NAME=llama3.2
